import sys
import argparse
import json
import textwrap

from iot2050_module_firmware_update import (
    ModuleFirmwareUpdateError,
    update_module_firmware,
)
from iot2050_firmware_operation_lock import FirmwareOperationBusy

def main(args):
    description=textwrap.dedent('''\
        Script for updating module firmware on IoT2050
        Examples usage:
          1. iot2050-module-firmware-update -s 1 -fwa firmwareA.bin
          2. iot2050-module-firmware-update -s 1 -fwa firmwareA.bin -fwb firmwareB.bin
         ''')
    parser = argparse.ArgumentParser(
        description=description,
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "-s", "--slot",
        type=int,
        required=True,
        help="Slot number"
    )
    parser.add_argument(
        "-fwa", "--firmware-a",
        help="Path to firmware A file",
        type=argparse.FileType('rb')
    )
    parser.add_argument(
        "-fwb", "--firmware-b",
        help="Path to firmware B file",
        type=argparse.FileType('rb')
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args(args)

    if not args.firmware_a and not args.firmware_b:
        if args.json:
            print(json.dumps({
                "ok": False,
                "error": {
                    "code": "missing-firmware",
                    "message": "No firmware file specified",
                },
            }, separators=(",", ":")))
        else:
            print("Error: No firmware file specified")
            parser.print_help()
        return 1

    try:
        results = update_module_firmware(
            args.slot,
            args.firmware_a,
            args.firmware_b,
            on_chip_start=(
                None if args.json
                else lambda chip: print(f"Updating firmware {chip} ...")
            ),
        )
    except FirmwareOperationBusy as e:
        if args.json:
            print(json.dumps({
                "ok": False,
                "error": {"code": "firmware-busy", "message": str(e)},
            }, separators=(",", ":")))
        else:
            print(f"Error: {e}")
        return 1
    except ModuleFirmwareUpdateError as e:
        if args.json:
            print(json.dumps({
                "ok": False,
                "error": {
                    "code": "module-update-failed",
                    "chip": e.chip,
                    "message": str(e.error),
                    "results": e.results,
                },
            }, separators=(",", ":")))
        else:
            print(f"Error: Failed to write firmware {e.chip}, {e.error}")
        return 1

    if args.json:
        print(json.dumps({
            "ok": True,
            "slot": args.slot,
            "chips": results,
            "reboot_required": True,
        }, separators=(",", ":")))
    else:
        print("Firmware updated successfully. Please reboot the upgraded module.")

    return 0

if __name__ == '__main__':
    CODE = main(sys.argv[1:])
    sys.exit(CODE)

