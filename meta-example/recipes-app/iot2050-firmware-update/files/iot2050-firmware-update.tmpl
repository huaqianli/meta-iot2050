"""CLI client for the System Firmware gRPC service."""

import argparse
import os
import textwrap
import sys
from threading import Thread

import grpc
from progress.bar import Bar

from iot2050_system_firmware_pb2 import RollbackRequest, UpdateRequest
from iot2050_system_firmware_pb2_grpc import SystemFirmwareStub
from iot2050_firmware_global import SYSTEM_FIRMWARE_SOCKET_TARGET


SOCKET_TARGET = SYSTEM_FIRMWARE_SOCKET_TARGET
# Semantic service error codes mapped to the documented CLI exit codes.
EXIT_CODES = {
    "backup-failed": 3,
    "rollback-failed": 4,
    "flashing-failed": 5,
    "firmware-incompatible": 7,
    "missing-signature": 9,
    "missing-key": 10,
    "bad-signature": 11,
}


def parser():
    description = textwrap.dedent("""\
        Update OSPI firmware.
        Examples:
        1. %(prog)s -f file.bin
             using binary format firmware
        2. %(prog)s  file.tar.xz
             using tarball format firmware
        3. %(prog)s -p "env1,env2" file.tar.xz
             using tarball format firmware, preserve environment follow -p
        4. %(prog)s -r file.tar.xz
             using tarball format firmware, reset environment
        5. %(prog)s -b
             rollback the firmware to the version before the upgrade
        6. %(prog)s --verify file.tar.xz
             perform a regular update, but enforce signature verification for the firmware

        Hardware operations are performed by the privileged gRPC service.
        """)
    epilog = textwrap.dedent("""\
        Return Value:
          | Error code  | Description                              |
          |-------------|------------------------------------------|
          | 0           | Success                                  |
          | 1           | Success to rollback                      |
          | 2           | Failed to parse the arguments            |
          | 3           | Failed to backup firmware                |
          | 4           | Failed to rollback the original firmware |
          | 5           | Flashing error                           |
          | 6           | User canceled                            |
          | 7           | Invalid firmware                         |
          | 8           | Failed to update                         |
          | 9           | Missing firmware signature               |
          | 10          | Missing public key                       |
          | 11          | Bad firmware signature                   |
        """)
    result = argparse.ArgumentParser(
        description=description,
        epilog=epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    group = result.add_mutually_exclusive_group()
    result.add_argument("firmware", nargs="?", metavar="FIRMWARE")
    group.add_argument("-f", "--force", action="store_true",
                       help="Force update, ignore package checks")
    group.add_argument("-p", "--preserve_list", type=str,
                       help="Comma-separated U-Boot environment variables")
    group.add_argument("-r", "--reset", action="store_true",
                       help="Reset the U-Boot environment")
    group.add_argument("-b", "--rollback", action="store_true",
                       help="Rollback to the previous firmware")
    result.add_argument("-v", "--version", action="version",
                        version="%(prog)s version: ${PV}")
    result.add_argument("-V", "--verify", action="store_true",
                        help="Enforce firmware signature verification")
    backup_group = result.add_mutually_exclusive_group()
    backup_group.add_argument("-n", "--no-backup", action="store_true",
                              help="Do not generate a firmware backup")
    backup_group.add_argument("-d", "--backup-dir", nargs=1,
                              help="Specify the firmware backup directory")
    result.add_argument("-q", "--quiet", action="store_true",
                        help="Do not prompt or reboot automatically")
    return result


def confirm(message, quiet):
    if quiet:
        return True
    try:
        return input(f"\033[1m{message} (y/N)? \033[0m").strip().lower() == "y"
    except EOFError:
        return False


def result_code(response, rollback=False):
    if response.ok:
        return 1 if rollback else 0
    return EXIT_CODES.get(response.code, 8)


def absolute_path(value):
    return os.path.abspath(value) if value else ""


def call_with_progress(method, request, label, quiet, timeout=None):
    """Run a blocking RPC while showing an indeterminate progress bar."""
    if quiet:
        return method(request, timeout=timeout)
    result = {}

    def worker():
        try:
            result["response"] = method(request, timeout=timeout)
        except Exception as error:
            result["error"] = error

    thread = Thread(target=worker, daemon=True)
    thread.start()
    with Bar(label.ljust(15), fill='.', bar_prefix='',
             bar_suffix='', suffix=''):
        while thread.is_alive():
            thread.join(timeout=0.2)
    if "error" in result:
        raise result["error"]
    return result["response"]


def main(argv=None):
    args = parser().parse_args(argv[1:] if argv else None)
    if args.force and (args.no_backup or args.backup_dir or args.verify):
        parser().error("argument -f/--force is not allowed with -n, -d, or --verify")
    if not args.rollback and not args.firmware:
        print("No firmware or action specified. A firmware file is required.",
              file=sys.stderr)
        return 2
    if not args.rollback and not os.path.isfile(absolute_path(args.firmware)):
        print(f"Firmware file not found: {args.firmware}", file=sys.stderr)
        return 2
    if not confirm("\nWarning: Update may render device unbootable. Continue",
                   args.quiet):
        return 6
    if args.reset and not confirm(
            "\nWarning: All U-Boot environment variables will be reset to"
            " factory settings. Continue",
            args.quiet):
        return 6
    if args.rollback and not confirm(
            "\nRollback the firmware to the version before the upgrade",
            args.quiet):
        return 6

    channel = grpc.insecure_channel(SOCKET_TARGET)
    stub = SystemFirmwareStub(channel)
    try:
        if args.rollback:
            response = call_with_progress(
                stub.Rollback,
                RollbackRequest(
                    backup_dir=absolute_path(
                        args.backup_dir[0] if args.backup_dir else ""),
                    legacy_cli=True,
                ),
                "Rolling back", args.quiet)
        else:
            preserve_list = [
                item.strip() for item in (args.preserve_list or "").split(",")
                if item.strip()
            ]
            response = call_with_progress(
                stub.Update,
                UpdateRequest(
                    firmware_path=absolute_path(args.firmware),
                    backup_dir=absolute_path(
                        args.backup_dir[0] if args.backup_dir else ""),
                    preserve_list=preserve_list,
                    reset=args.reset,
                    no_backup=args.no_backup,
                    force=args.force,
                    verify_signature=args.verify,
                    legacy_cli=True,
                ),
                "Updating firmware", args.quiet, timeout=3600)
    except grpc.RpcError as error:
        print(f"System Firmware service unavailable: {error.details()}",
              file=sys.stderr)
        return 8
    finally:
        channel.close()

    if not response.ok:
        print(response.message, file=sys.stderr)
        if response.code == "flashing-failed" and not args.quiet:
            print(
                "\n   ====================================\n"
                "   Upgrade Failed! Please do not reboot!!\n"
                "   The Device may become brick.\n"
                "   Please try to rollback!\n"
                "   ====================================\n"
                "Hit the Enter Key to Exit:",
                file=sys.stderr,
            )
            try:
                input()
            except EOFError:
                pass
        return result_code(response, args.rollback)
    print(response.message)
    if not args.quiet:
        if confirm("\nWarning: Completed. Please reboot the device. Reboot now",
                   args.quiet):
            os.system("reboot")
    return result_code(response, args.rollback)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
